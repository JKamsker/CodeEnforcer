<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>code-enforcer</ToolCommandName>
    <PackageId>CodeEnforcer</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Jonas Kamsker</Authors>
    <Description>Repository-local C# structure gate for file length and folder size rules.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>csharp;quality;cli;tooling</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/JKamsker/CodeEnforcer</RepositoryUrl>
    <PackageProjectUrl>https://github.com/JKamsker/CodeEnforcer</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
